{
  "name": "dsh-hyperworkbuddy",
  "displayName": "DSH HyperWorkBuddy",
  "description": "WorkBuddy 多账号管理与 DSH 直连模型：设置里一级 WorkBuddy 面板管理多账号池，同时把模型直接接进 DSH 并暴露 OpenAI 兼容端点。",
  "version": "0.1.0",
  "author": "ChaYeWuu",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "workbuddy",
    "multi-account",
    "model-provider",
    "openai-compatible"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChaYeWuu/dsh-hyperworkbuddy.git"
  },
  "homepage": "https://github.com/ChaYeWuu/dsh-hyperworkbuddy#readme",
  "bugs": {
    "url": "https://github.com/ChaYeWuu/dsh-hyperworkbuddy/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": "^0.2.0-rc.1"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.87.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.87.1",
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "semver": "^7.7.2",
    "typescript": "^5.9.3"
  }
}
